
<!DOCTYPE html>
<!--
  De-Stress Studio — GY-GY Club
  Prototype version: 1.2.0
  Change: redesigned full-width layout, compact Charlie avatar,
          separated workspace panels, responsive photo background.
  Integration note: preserve the original file path and creation date
  when integrating into the GY-GY Club core architecture.
-->
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#100e0b">
  <title>De-Stress Studio — GY-GY Club</title>

  <style>
    :root {
      --black: #100e0b;
      --panel: rgba(22, 19, 15, 0.96);
      --panel-soft: rgba(31, 26, 19, 0.96);
      --gold: #d8b36a;
      --gold-light: #f0d69d;
      --gold-dark: #76582d;
      --text: #f0e8d8;
      --muted: #b0a38d;
      --line: rgba(216, 179, 106, 0.28);
      --radius: 14px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      min-height: 100%;
      background: var(--black);
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text);
      background: var(--black);
      font-family: Inter, "Segoe UI", Arial, sans-serif;
      font-size: 15px;
      line-height: 1.5;
    }

    button,
    input {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    button:focus-visible,
    input:focus-visible {
      outline: 2px solid var(--gold-light);
      outline-offset: 3px;
    }

    /* Background image is independent from the interface. */

    .background-photo {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        linear-gradient(
          90deg,
          rgba(10, 9, 7, 0.88),
          rgba(10, 9, 7, 0.76) 48%,
          rgba(10, 9, 7, 0.88)
        ),
        linear-gradient(
          0deg,
          rgba(10, 9, 7, 0.92),
          rgba(10, 9, 7, 0.32) 55%,
          rgba(10, 9, 7, 0.70)
        ),
        url("destress_bg.jpg") center / cover no-repeat,
        #100e0b;
    }

    .page {
      position: relative;
      z-index: 1;
      width: min(100% - 44px, 1500px);
      min-height: 100vh;
      margin: 0 auto;
      padding: 18px 0 24px;
      display: flex;
      flex-direction: column;
    }

    /* HEADER */

    .topbar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 20px;
      min-height: 82px;
      padding: 8px 4px 18px;
      border-bottom: 1px solid var(--line);
    }

    .nav-area {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 10px;
      min-width: 0;
    }

    .nav-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 40px;
      padding: 8px 13px;
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--gold-light);
      background: rgba(20, 17, 13, 0.84);
      text-decoration: none;
      transition: background 160ms ease, border-color 160ms ease;
    }

    .nav-button:hover {
      background: #302617;
      border-color: var(--gold);
    }

    .language-switch {
      display: flex;
      gap: 3px;
      margin-left: 4px;
      padding: 3px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: rgba(12, 10, 8, 0.8);
    }

    .language-button {
      padding: 6px 7px;
      border: 0;
      border-radius: 5px;
      color: var(--muted);
      background: transparent;
      font-size: 11px;
      font-weight: 700;
    }

    .language-button.active {
      color: #18120a;
      background: var(--gold);
    }

    .charlie-brand {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      min-width: 0;
      text-align: left;
    }

    .charlie-avatar {
      display: block;
      flex: 0 0 auto;
      width: 62px;
      height: 62px;
      border: 2px solid var(--gold-dark);
      border-radius: 50%;
      background: #211a10;
      object-fit: cover;
      box-shadow: 0 0 0 4px rgba(216, 179, 106, 0.07);
    }

    .charlie-copy {
      min-width: 0;
    }

    .charlie-name {
      margin: 0;
      color: var(--gold-light);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 23px;
      font-weight: 500;
      line-height: 1.15;
    }

    .charlie-caption {
      margin-top: 5px;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .club-brand {
      justify-self: end;
      text-align: right;
      text-decoration: none;
      color: var(--gold-light);
    }

    .club-logo {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(28px, 3vw, 40px);
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0.045em;
    }

    .club-subtitle {
      margin-top: 5px;
      color: var(--gold);
      font-size: 10px;
      letter-spacing: 0.34em;
    }

    /* INTRO */

    .intro {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      padding: 24px 2px 22px;
    }

    .eyebrow {
      margin: 0 0 7px;
      color: var(--gold);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .page-title {
      margin: 0;
      color: var(--gold-light);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(27px, 3vw, 39px);
      font-weight: 400;
      letter-spacing: -0.025em;
      line-height: 1.1;
    }

    .intro-description {
      max-width: 470px;
      margin: 0;
      color: var(--muted);
      text-align: right;
      font-size: 13px;
    }

    /* MAIN WORKSPACE */

    .workspace {
      display: grid;
      grid-template-columns: minmax(210px, 0.78fr)
                             minmax(290px, 1.12fr)
                             minmax(290px, 1.12fr);
      gap: 18px;
      align-items: stretch;
    }

    .panel {
      min-width: 0;
      padding: 23px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--panel);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    }

    .panel-heading {
      display: flex;
      align-items: start;
      gap: 12px;
      margin-bottom: 19px;
    }

    .step-number {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 34px;
      width: 34px;
      height: 34px;
      border: 1px solid var(--gold-dark);
      border-radius: 9px;
      color: var(--gold-light);
      background: rgba(216, 179, 106, 0.08);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 17px;
    }

    .panel-title {
      margin: 2px 0 4px;
      color: var(--gold-light);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 22px;
      font-weight: 400;
      line-height: 1.2;
    }

    .panel-subtitle {
      margin: 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.5;
    }

    /* CHARLIE PANEL */

    .charlie-panel {
      display: flex;
      flex-direction: column;
      background:
        linear-gradient(
          160deg,
          rgba(49, 37, 22, 0.42),
          rgba(20, 17, 13, 0.97) 65%
        );
    }

    .charlie-mark {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 105px;
      margin: 0 0 20px;
      border: 1px solid rgba(216, 179, 106, 0.14);
      border-radius: 10px;
      background:
        radial-gradient(
          ellipse at center,
          rgba(216, 179, 106, 0.12),
          transparent 68%
        );
    }

    .charlie-mark span {
      color: var(--gold);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 52px;
      opacity: 0.8;
    }

    .charlie-quote {
      margin: 0 0 16px;
      color: var(--text);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 19px;
      line-height: 1.45;
    }

    .charlie-quote em {
      color: var(--gold-light);
      font-style: normal;
    }

    .charlie-description {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.8;
    }

    .charlie-signature {
      margin-top: auto;
      padding-top: 22px;
      color: var(--gold);
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .small-divider {
      width: 48px;
      height: 1px;
      margin: 17px 0;
      background: var(--gold-dark);
    }

    /* CHOICES */

    .choice-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
    }

    .choice-button {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 61px;
      padding: 11px 12px;
      border: 1px solid rgba(216, 179, 106, 0.19);
      border-radius: 9px;
      color: var(--text);
      background: rgba(255, 255, 255, 0.025);
      text-align: left;
      transition: background 160ms ease, border-color 160ms ease,
                  transform 160ms ease;
    }

    .choice-button:hover {
      border-color: var(--gold-dark);
      background: rgba(216, 179, 106, 0.075);
      transform: translateY(-1px);
    }

    .choice-button.selected {
      border-color: var(--gold);
      background: rgba(216, 179, 106, 0.13);
      box-shadow: inset 0 0 0 1px rgba(216, 179, 106, 0.12);
    }

    .choice-symbol {
      flex: 0 0 auto;
      width: 27px;
      text-align: center;
      color: var(--gold);
      font-size: 19px;
    }

    .choice-label {
      font-size: 12px;
      line-height: 1.4;
    }

    .selection-note {
      min-height: 38px;
      margin: 14px 0 0;
      color: var(--muted);
      font-size: 12px;
    }

    /* RECIPE PANEL */

    .recipe-panel {
      background:
        linear-gradient(
          145deg,
          rgba(46, 34, 20, 0.35),
          rgba(22, 19, 15, 0.98) 58%
        );
    }

    .recipe-card {
      min-height: 184px;
      padding: 20px;
      border: 1px solid rgba(216, 179, 106, 0.28);
      border-radius: 11px;
      background: rgba(9, 8, 6, 0.5);
    }

    .recipe-label {
      margin: 0 0 13px;
      color: var(--gold);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .recipe-title {
      margin: 0 0 12px;
      color: var(--gold-light);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 25px;
      font-weight: 400;
      line-height: 1.25;
    }

    .recipe-description {
      margin: 0;
      color: var(--text);
      font-size: 13px;
      line-height: 1.75;
    }

    .recipe-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 16px;
    }

    .text-button {
      padding: 7px 0;
      border: 0;
      color: var(--gold-light);
      background: transparent;
      font-size: 12px;
    }

    .text-button:hover {
      color: white;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    /* CUSTOM RECIPE — FULL WIDTH */

    .custom-panel {
      margin-top: 18px;
      padding: 22px 25px;
      border: 1px solid var(--gold-dark);
      border-radius: var(--radius);
      background:
        linear-gradient(
          105deg,
          rgba(45, 34, 21, 0.97),
          rgba(20, 17, 13, 0.97) 60%
        );
    }

    .custom-layout {
      display: grid;
      grid-template-columns: minmax(190px, 0.72fr)
                             minmax(220px, 1.45fr)
                             minmax(290px, 1fr);
      align-items: center;
      gap: 22px;
    }

    .custom-title {
      margin: 0 0 5px;
      color: var(--gold-light);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 22px;
      font-weight: 400;
    }

    .custom-description {
      margin: 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.6;
    }

    .custom-form {
      display: flex;
      gap: 8px;
      min-width: 0;
    }

    .custom-input {
      width: 100%;
      min-width: 0;
      min-height: 46px;
      padding: 11px 13px;
      border: 1px solid rgba(216, 179, 106, 0.32);
      border-radius: 8px;
      color: var(--text);
      background: rgba(8, 7, 5, 0.72);
    }

    .custom-input::placeholder {
      color: #8f8370;
    }

    .gold-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-height: 43px;
      padding: 10px 15px;
      border: 1px solid var(--gold);
      border-radius: 8px;
      color: #1a1308;
      background: var(--gold);
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
      transition: background 160ms ease, transform 160ms ease;
    }

    .gold-button:hover {
      background: var(--gold-light);
      transform: translateY(-1px);
    }

    .outline-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 43px;
      padding: 10px 13px;
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--gold-light);
      background: rgba(0, 0, 0, 0.18);
      font-size: 12px;
      font-weight: 600;
      text-align: center;
      text-decoration: none;
      transition: background 160ms ease, border-color 160ms ease;
    }

    .outline-button:hover {
      border-color: var(--gold);
      background: rgba(216, 179, 106, 0.08);
    }

    .action-buttons {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .action-buttons .atelier-button {
      grid-column: 1 / -1;
    }

    .status-message {
      min-height: 18px;
      margin: 11px 0 0;
      color: var(--gold-light);
      font-size: 12px;
    }

    /* FOOTER */

    .footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-top: auto;
      padding: 23px 4px 0;
      color: #8c806b;
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .footer strong {
      color: var(--gold-dark);
      font-weight: 600;
    }

    /* RESPONSIVE */

    @media (min-width: 1200px) {
      .workspace {
        min-height: 340px;
      }

      .panel {
        padding: 25px;
      }
    }

    @media (max-width: 1050px) {
      .page {
        width: min(100% - 32px, 900px);
      }

      .workspace {
        grid-template-columns: 0.8fr 1.2fr;
      }

      .charlie-panel {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: 120px 1fr;
        column-gap: 22px;
        align-items: center;
      }

      .charlie-panel .panel-heading {
        grid-column: 1 / -1;
      }

      .charlie-mark {
        grid-row: span 2;
        margin: 0;
        min-height: 120px;
      }

      .charlie-quote {
        margin-bottom: 8px;
      }

      .charlie-description {
        grid-column: 2;
      }

      .charlie-signature {
        grid-column: 2;
        margin-top: 12px;
        padding-top: 0;
      }

      .custom-layout {
        grid-template-columns: 1fr 1.5fr;
      }

      .action-buttons {
        grid-column: 1 / -1;
      }

      .action-buttons .atelier-button {
        grid-column: auto;
      }
    }

    @media (max-width: 700px) {
      .page {
        width: min(100% - 24px, 560px);
        padding-top: 10px;
      }

      .topbar {
        grid-template-columns: 1fr auto;
        gap: 12px;
        padding-bottom: 13px;
      }

      .nav-area {
        grid-column: 1 / -1;
        grid-row: 2;
        flex-wrap: wrap;
      }

      .charlie-brand {
        grid-column: 1;
        grid-row: 1;
        justify-content: flex-start;
      }

      .charlie-avatar {
        width: 49px;
        height: 49px;
      }

      .charlie-name {
        font-size: 19px;
      }

      .club-brand {
        grid-column: 2;
        grid-row: 1;
      }

      .club-logo {
        font-size: 30px;
      }

      .nav-button {
        min-height: 37px;
        padding: 7px 10px;
        font-size: 12px;
      }

      .intro {
        display: block;
        padding: 23px 2px 18px;
      }

      .intro-description {
        margin-top: 10px;
        text-align: left;
      }

      .workspace {
        grid-template-columns: 1fr;
        gap: 13px;
      }

      .charlie-panel {
        grid-column: auto;
        grid-template-columns: 78px 1fr;
        gap: 0 16px;
      }

      .charlie-panel .panel-heading {
        grid-column: 1 / -1;
      }

      .charlie-mark {
        grid-row: 2 / span 2;
        min-height: 78px;
      }

      .charlie-mark span {
        font-size: 36px;
      }

      .charlie-quote {
        font-size: 17px;
      }

      .charlie-description {
        grid-column: 2;
      }

      .charlie-signature {
        grid-column: 1 / -1;
      }

      .panel {
        padding: 19px;
      }

      .custom-panel {
        margin-top: 13px;
        padding: 19px;
      }

      .custom-layout {
        grid-template-columns: 1fr;
        gap: 15px;
      }

      .action-buttons {
        grid-column: auto;
        grid-template-columns: 1fr;
      }

      .action-buttons .atelier-button {
        grid-column: auto;
      }

      .footer {
        align-items: flex-start;
        flex-direction: column;
        gap: 6px;
      }
    }

    @media (max-width: 390px) {
      .language-switch {
        margin-left: 0;
      }

      .choice-list {
        grid-template-columns: 1fr;
      }

      .custom-form {
        flex-direction: column;
      }

      .custom-form .gold-button {
        width: 100%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>
  <div class="background-photo" aria-hidden="true"></div>

  <div class="page">
    <header class="topbar">
      <nav class="nav-area" aria-label="Основная навигация">
        <a class="nav-button" href="bar_navigation.html">
          <span aria-hidden="true">←</span>
          <span>В клуб</span>
        </a>

        <div class="language-switch" aria-label="Язык интерфейса">
          <button class="language-button active" type="button"
                  data-language="ru" aria-pressed="true">RU</button>
          <button class="language-button" type="button"
                  data-language="en" aria-pressed="false">EN</button>
          <button class="language-button" type="button"
                  data-language="fr" aria-pressed="false">FR</button>
        </div>
      </nav>

      <div class="charlie-brand">
        <img
          class="charlie-avatar"
          src="horse_welcome.png"
          alt="Чарли — хозяин De-Stress Studio"
          onerror="this.style.display='none'"
        >
        <div class="charlie-copy">
          <h2 class="charlie-name">Чарли</h2>
          <div class="charlie-caption">Твой антистресс-бармен</div>
        </div>
      </div>

      <a class="club-brand" href="bar_navigation.html"
         aria-label="GY-GY Club — главная">
        <div class="club-logo">GY-GY</div>
        <div class="club-subtitle">CLUB</div>
      </a>
    </header>

    <section class="intro">
      <div>
        <p class="eyebrow">Территория без лишнего драматизма</p>
        <h1 class="page-title">De-Stress Studio</h1>
      </div>
      <p class="intro-description">
        Расскажи, что случилось. Чарли выслушает, добавит щепотку иронии
        и попробует превратить твою ситуацию в историю.
      </p>
    </section>

    <main>
      <section class="workspace" aria-label="Студия антистресса">

        <!-- ZONE 1: CHARLIE -->

        <article class="panel charlie-panel">
          <div class="panel-heading">
            <div class="step-number" aria-hidden="true">★</div>
            <div>
              <h2 class="panel-title">Место Чарли</h2>
              <p class="panel-subtitle">Спокойствие — тоже искусство</p>
            </div>
          </div>

          <div class="charlie-mark" aria-hidden="true">
            <span>“</span>
          </div>

          <p class="charlie-quote">
            «Не всё нужно решать сегодня.
            Иногда достаточно <em>сменить угол зрения.</em>»
          </p>

          <p class="charlie-description">
            Здесь не читают нотаций и не выдают универсальных истин.
            Здесь ищут неожиданный взгляд на обычные неприятности.
          </p>

          <div class="charlie-signature">Чарли · За стойкой</div>
        </article>

        <!-- ZONE 2: SELECT A SITUATION -->

        <article class="panel">
          <div class="panel-heading">
            <div class="step-number">01</div>
            <div>
              <h2 class="panel-title">Что случилось?</h2>
              <p class="panel-subtitle">
                Выбери ситуацию — или хотя бы её настроение
              </p>
            </div>
          </div>

          <div class="choice-list" id="situationChoices">
            <button class="choice-button" type="button"
                    data-situation="work">
              <span class="choice-symbol" aria-hidden="true">⌁</span>
              <span class="choice-label">Работа достала</span>
            </button>

            <button class="choice-button" type="button"
                    data-situation="people">
              <span class="choice-symbol" aria-hidden="true">♧</span>
              <span class="choice-label">Люди удивляют</span>
            </button>

            <button class="choice-button" type="button"
                    data-situation="chaos">
              <span class="choice-symbol" aria-hidden="true">〰</span>
              <span class="choice-label">Всё пошло не так</span>
            </button>

            <button class="choice-button" type="button"
                    data-situation="tired">
              <span class="choice-symbol" aria-hidden="true">☾</span>
              <span class="choice-label">Просто устал</span>
            </button>

            <button class="choice-button" type="button"
                    data-situation="money">
              <span class="choice-symbol" aria-hidden="true">◇</span>
              <span class="choice-label">Деньги испарились</span>
            </button>

            <button class="choice-button" type="button"
                    data-situation="other">
              <span class="choice-symbol" aria-hidden="true">?</span>
              <span class="choice-label">Сам не понял</span>
            </button>
          </div>

          <p class="selection-note" id="selectionNote" aria-live="polite">
            Выбери пункт, и Чарли подберёт свой рецепт.
          </p>
        </article>

        <!-- ZONE 3: CHARLIE'S RECIPE -->

        <article class="panel recipe-panel">
          <div class="panel-heading">
            <div class="step-number">02</div>
            <div>
              <h2 class="panel-title">Рецепт Чарли</h2>
              <p class="panel-subtitle">Не медицина. Немного клубной алхимии.</p>
            </div>
          </div>

          <div class="recipe-card" aria-live="polite" aria-atomic="true">
            <p class="recipe-label" id="recipeLabel">Рецепт дня</p>
            <h3 class="recipe-title" id="recipeTitle">
              Коктейль «Потом разберёмся»
            </h3>
            <p class="recipe-description" id="recipeDescription">
              Две части самоиронии, одна часть свежего воздуха и
              полный отказ принимать каждую мелочь за конец света.
              Перемешать. Не взбалтывать окружающих.
            </p>
          </div>

          <div class="recipe-controls">
            <button class="text-button" type="button" id="anotherRecipe">
              ↻ Другой замес
            </button>
            <button class="text-button" type="button" id="copyRecipe">
              Копировать рецепт ↗
            </button>
          </div>
        </article>
      </section>

      <!-- ZONE 4: USER'S OWN IDEA -->

      <section class="custom-panel" aria-labelledby="customTitle">
        <div class="custom-layout">
          <div>
            <p class="eyebrow">Твоя очередь</p>
            <h2 class="custom-title" id="customTitle">
              Твой рецепт — твои правила
            </h2>
            <p class="custom-description">
              Придумай свой способ пережить день.
              Чем неожиданнее, тем интереснее.
            </p>
          </div>

          <div>
            <form class="custom-form" id="customRecipeForm">
              <input
                class="custom-input"
                id="customRecipeInput"
                name="recipe"
                type="text"
                maxlength="180"
                placeholder="Например: выключить серьёзность на час..."
                aria-label="Твой собственный рецепт"
                required
              >
              <button class="gold-button" type="submit">
                + Добавить
              </button>
            </form>
            <p class="status-message" id="statusMessage"
               role="status" aria-live="polite"></p>
          </div>

          <div class="action-buttons">
            <button class="outline-button" id="publishNews"
                    type="button">
              В новости клуба
            </button>

            <button class="outline-button atelier-button" id="goToAtelier"
                    type="button">
              Передать фразу в Ателье →
            </button>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <span><strong>GY-GY Club</strong> · De-Stress Studio</span>
      <span>Меньше драмы. Больше воображения.</span>
    </footer>
  </div>

  <script>
    "use strict";

    /*
      Standalone prototype.
      Recipes are held in memory for this page session only.
      News publishing and multilingual content require integration.
    */

    const recipes = {
      default: [
        {
          title: "Коктейль «Потом разберёмся»",
          description:
            "Две части самоиронии, одна часть свежего воздуха и полный отказ " +
            "принимать каждую мелочь за конец света. Перемешать. " +
            "Не взбалтывать окружающих."
        },
        {
          title: "Настойка на здравом смысле",
          description:
            "Возьми паузу, отойди на пару шагов и посмотри на ситуацию " +
            "со стороны. Если проблема всё ещё огромная — попробуй " +
            "посмотреть с другой стороны."
        },
        {
          title: "Лёд для горячей головы",
          description:
            "Добавь немного тишины, убери лишние уведомления и не принимай " +
            "важных решений на пике раздражения. Дать настояться."
        },
        {
          title: "Фирменный «Ну и ладно»",
          description:
            "Одна щепотка принятия, две капли юмора и право не контролировать " +
            "всю Вселенную. Подавать без чувства вины."
        }
      ],

      work: [
        {
          title: "Отвар «Я не весь офис»",
          description:
            "Отдели свою работу от чужого хаоса. Выполни следующий " +
            "посильный шаг, а остальное пусть немного подождёт."
        },
        {
          title: "Эспрессо с границами",
          description:
            "Одна ясная задача, одна честная пауза и ни одного обещания " +
            "сделать всё одновременно. Даже у кофе есть предел."
        }
      ],

      people: [
        {
          title: "Настойка «Каждый со своим цирком»",
          description:
            "Не обязательно покупать билет на каждое чужое представление. " +
            "Иногда достаточно вежливо остаться зрителем."
        },
        {
          title: "Коктейль «Не моя радиостанция»",
          description:
            "Чужие мнения могут звучать громко, но регулятор громкости " +
            "всё ещё у тебя. Не каждую передачу нужно слушать."
        }
      ],

      chaos: [
        {
          title: "Микс «План Б — это тоже план»",
          description:
            "Убери из меню ожидание идеального дня. Выбери один следующий " +
            "шаг и позволь остальному перестать изображать катастрофу."
        },
        {
          title: "Суп «Разгребаем по ложке»",
          description:
            "Не пытайся проглотить весь беспорядок за один раз. " +
            "Одна маленькая задача тоже считается победой."
        }
      ],

      tired: [
        {
          title: "Тёплый чай «Без подвигов»",
          description:
            "Сегодня необязательно становиться легендой. Вода, еда, " +
            "отдых и немного меньше требований к себе — вполне достойный план."
        },
        {
          title: "Лимонад «Режим улитки»",
          description:
            "Снизь скорость, если можешь. Даже самая продуктивная улитка " +
            "не пытается обогнать спортивный автомобиль."
        }
      ],

      money: [
        {
          title: "Коктейль «Считаем без паники»",
          description:
            "Сначала посмотри на реальные цифры, потом решай, что делать. " +
            "Тревога умеет считать намного быстрее калькулятора — " +
            "и далеко не всегда правильно."
        },
        {
          title: "Лимонад «Не всё измеряется ценником»",
          description:
            "Финансы требуют внимания, но не обязаны определять твою " +
            "ценность. Начни с одного понятного действия."
        }
      ],

      other: [
        {
          title: "Настойка «Пока без названия»",
          description:
            "Необязательно сразу понимать всё происходящее. " +
            "Иногда первая полезная мысль — признать, что пока непонятно."
        },
        {
          title: "Коктейль «Сначала выдохнем»",
          description:
            "Пауза не решает всё, но помогает не добавлять к одной " +
            "непонятной ситуации ещё три поспешных решения."
        }
      ]
    };

    const situationLabels = {
      work: "Работа достала",
      people: "Люди удивляют",
      chaos: "Всё пошло не так",
      tired: "Просто устал",
      money: "Деньги испарились",
      other: "Сам не понял"
    };

    const state = {
      situation: null,
      currentRecipe: null,
      currentRecipeText: "",
      userRecipes: [],
      lastIndexes: {}
    };

    const recipeTitle = document.getElementById("recipeTitle");
    const recipeDescription = document.getElementById("recipeDescription");
    const recipeLabel = document.getElementById("recipeLabel");
    const selectionNote = document.getElementById("selectionNote");
    const statusMessage = document.getElementById("statusMessage");
    const customRecipeInput = document.getElementById("customRecipeInput");

    function getRecipePool() {
      const selected = state.situation || "default";
      const base = recipes[selected] || recipes.default;

      return base.concat(state.userRecipes);
    }

    function chooseRecipe() {
      const pool = getRecipePool();

      if (!pool.length) {
        return;
      }

      let index = 0;

      if (pool.length > 1) {
        const previous = state.lastIndexes[state.situation || "default"];
        do {
          index = Math.floor(Math.random() * pool.length);
        } while (index === previous);
      }

      state.lastIndexes[state.situation || "default"] = index;
      state.currentRecipe = pool[index];

      renderRecipe();
    }

    function renderRecipe() {
      if (!state.currentRecipe) return;

      recipeTitle.textContent = state.currentRecipe.title;
      recipeDescription.textContent = state.currentRecipe.description;
      recipeLabel.textContent = state.situation
        ? "Рецепт для ситуации"
        : "Рецепт дня";

      state.currentRecipeText =
        state.currentRecipe.title + "\n\n" +
        state.currentRecipe.description;
    }

    function selectSituation(situation) {
      state.situation = situation;

      document.querySelectorAll("[data-situation]").forEach((button) => {
        const selected = button.dataset.situation === situation;
        button.classList.toggle("selected", selected);
        button.setAttribute("aria-pressed", String(selected));
      });

      selectionNote.textContent =
        "Ситуация: " + (situationLabels[situation] || "другое") +
        ". Чарли предлагает взглянуть на неё иначе.";

      statusMessage.textContent = "";
      chooseRecipe();
    }

    document.querySelectorAll("[data-situation]").forEach((button) => {
      button.setAttribute("aria-pressed", "false");

      button.addEventListener("click", () => {
        selectSituation(button.dataset.situation);
      });
    });

    document.getElementById("anotherRecipe").addEventListener("click", () => {
      chooseRecipe();
      statusMessage.textContent = "Чарли смешал новый вариант.";
    });

    document.getElementById("copyRecipe").addEventListener("click", async () => {
      if (!state.currentRecipeText) return;

      try {
        await navigator.clipboard.writeText(state.currentRecipeText);
        statusMessage.textContent = "Рецепт скопирован.";
      } catch {
        statusMessage.textContent =
          "Не удалось скопировать автоматически. Выдели текст рецепта вручную.";
      }
    });

    document.getElementById("customRecipeForm").addEventListener("submit", (event) => {
      event.preventDefault();

      const text = customRecipeInput.value.trim();

      if (!text) {
        statusMessage.textContent = "Сначала напиши свой рецепт.";
        return;
      }

      const customRecipe = {
        title: "Твой рецепт",
        description: text
      };

      state.userRecipes.push(customRecipe);
      state.currentRecipe = customRecipe;
      renderRecipe();

      statusMessage.textContent =
        "Твой рецепт добавлен в текущую сессию. Он пока не сохранён в базе клуба.";

      customRecipeInput.value = "";
    });

    document.getElementById("publishNews").addEventListener("click", () => {
      statusMessage.textContent =
        "Публикация в новостях пока не подключена. Для этого нужна интеграция с системой клуба.";
    });

    document.getElementById("goToAtelier").addEventListener("click", () => {
      const phrase = state.currentRecipe
        ? state.currentRecipe.title + " — " + state.currentRecipe.description
        : "";

      const target = "atelier.html?phrase=" + encodeURIComponent(phrase);
      window.location.href = target;
    });

    document.querySelectorAll("[data-language]").forEach((button) => {
      button.addEventListener("click", () => {
        const language = button.dataset.language;

        document.querySelectorAll("[data-language]").forEach((item) => {
          const active = item === button;
          item.classList.toggle("active", active);
          item.setAttribute("aria-pressed", String(active));
        });

        if (language === "ru") {
          statusMessage.textContent = "Выбран русский язык.";
        } else {
          statusMessage.textContent =
            "Переключатель языка работает. Переводы EN/FR подключим отдельно.";
        }
      });
    });

    // Initial state
    chooseRecipe();
  </script>
</body>
</html>
